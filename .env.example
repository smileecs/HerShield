# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY=""

# APP_URL / FRONTEND_URL: The URL where this applet is hosted.
APP_URL=""
FRONTEND_URL=""

# JWT_SECRET: Secret used for signing JWT authentication tokens
JWT_SECRET="hershield_secure_jwt_secret_key"

# MAPS_API_KEY / GOOGLE_MAPS_PLATFORM_KEY: Optional API key for Google Maps / Routes API.
# If unconfigured, HerShield automatically uses free real-time geocoding (Nominatim) and routing (OSRM).
MAPS_API_KEY=""
GOOGLE_MAPS_PLATFORM_KEY=""

# EMAIL SERVICE CONFIGURATION (Nodemailer / SMTP):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="HerShield Safety <noreply@hershield.app>"

FRONTEND_URL=

# Optional Gmail specific environment variable aliases:
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

